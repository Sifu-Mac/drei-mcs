# App
APP_NAME=Mission Control
APP_HOST=mission.digitalbackup.cloud
APP_URL=https://mission.digitalbackup.cloud
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
PORT=3000
SOLID_QUEUE_IN_PUMA=1
DB_POOL=10

# Secrets
SECRET_KEY_BASE=generate_a_long_random_secret
MAILER_FROM=noreply@mission.digitalbackup.cloud

# Database
POSTGRES_DB=mission_control_production
POSTGRES_USER=mission_control
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://mission_control:change_me@db:5432/mission_control_production

# Optional GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional Traefik override if your external Docker network is not named "traefik"
TRAEFIK_NETWORK=traefik
