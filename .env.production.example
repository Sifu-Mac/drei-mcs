# App
APP_NAME=DREI Asset Review
APP_HOST=mission.digitalbackup.cloud
APP_URL=https://mission.digitalbackup.cloud
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
PORT=3000
SOLID_QUEUE_IN_PUMA=1
DB_POOL=10

# Secrets
SECRET_KEY_BASE=generate_a_long_random_secret
MAILER_FROM=noreply@mission.digitalbackup.cloud

# Database
POSTGRES_DB=drei_mcs_production
POSTGRES_USER=drei_mcs
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://drei_mcs:change_me@db:5432/drei_mcs_production

# Optional GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional SMTP (invite/password emails)
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
