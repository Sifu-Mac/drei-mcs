<%# Board-spezifische Modals — Board-Einstellungen only (Neue-Kampagne-Modal is in shared/navbar) %>

<script>
  function selectEditBoardIcon(btn, icon) {
    document.getElementById('edit-board-icon-field').value = icon;
    document.querySelectorAll('#edit-icon-group button').forEach(b => {
      b.classList.remove('ring-2', 'ring-accent');
    });
    btn.classList.add('ring-2', 'ring-accent');
  }
</script>

<%# Board-Einstellungen Modal %>
<div id="board-settings-modal"
     data-modal-manager-target="modal"
     aria-hidden="true"
     role="dialog"
     aria-modal="true"
     aria-labelledby="board-settings-modal-title"
     class="hidden fixed inset-0 z-50 flex items-center justify-center"
     data-action="click->modal-manager#closeOnBackdrop">
  <div class="absolute inset-0 bg-slate-900/25 backdrop-blur-sm"
       data-action="click->modal-manager#close"></div>
  <div class="relative bg-bg-surface border border-border rounded-xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden" style="box-shadow:0 24px 70px rgba(15,23,42,0.18);">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <span id="board-settings-modal-title" class="text-sm font-bold text-content">Board-Einstellungen</span>
      <button type="button"
              data-action="click->modal-manager#close"
              aria-label="Dialog schließen"
              class="p-2 rounded-lg text-content-muted hover:text-content hover:bg-bg-hover transition-colors cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= form_with model: @board, url: board_path(@board), method: :patch, class: "p-5 space-y-4" do |form| %>
      <div>
        <label class="block text-sm font-medium text-content-secondary mb-2">Boardname</label>
        <%= form.text_field :name,
            required: true,
            placeholder: "z. B. Assets, Social, Print",
            class: "w-full px-3 py-2 text-sm bg-bg-card border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent text-content placeholder-content-muted" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-content-secondary mb-2">Icon</label>
        <div class="flex flex-wrap gap-2" id="edit-icon-group">
          <% edit_icons = Board::DEFAULT_ICONS.dup %>
          <% if current_user.agent_last_active_at.present? && current_user.agent_emoji.present? && !edit_icons.include?(current_user.agent_emoji) %>
            <% edit_icons << current_user.agent_emoji %>
          <% end %>
          <% if @board.icon.present? && !edit_icons.include?(@board.icon) %>
            <% edit_icons << @board.icon %>
          <% end %>
          <% edit_icons.each do |icon| %>
            <button type="button"
                    onclick="selectEditBoardIcon(this, '<%= icon %>')"
                    data-icon="<%= icon %>"
                    class="w-10 h-10 flex items-center justify-center rounded-lg bg-bg-card hover:bg-bg-hover border border-border transition-colors text-xl cursor-pointer <%= icon == @board.icon ? 'ring-2 ring-accent' : '' %>">
              <%= icon %>
            </button>
          <% end %>
        </div>
        <%= form.hidden_field :icon, value: @board.icon, id: "edit-board-icon-field" %>
      </div>

      <div class="flex items-center justify-between pt-2">
        <% if @boards.count > 1 %>
          <%= link_to archive_board_path(@board),
              method: :patch,
              data: { turbo_method: :patch, turbo_confirm: "Board archivieren? Karten bleiben erhalten." },
              class: "text-sm text-status-error hover:text-status-error/80 transition-colors cursor-pointer" do %>
            Board archivieren
          <% end %>
        <% else %>
          <span></span>
        <% end %>

        <div class="flex items-center gap-3">
          <button type="button"
                  data-action="click->modal-manager#close"
                  class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-bg-elevated hover:bg-bg-hover text-content-secondary border border-border transition-colors cursor-pointer">
            Abbrechen
          </button>
          <%= form.submit "Speichern", class: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-accent text-content-inverse hover:bg-accent-hover transition-colors cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
