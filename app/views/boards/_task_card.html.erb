<% has_current_user = defined?(current_user) && current_user %>
<% internal_user = has_current_user && internal_workspace_member? %>
<% is_done = task.completed? %>
<% board_color = task.board.color || "red" %>
<% accent_color = task.color_hex %>
<li id="task_<%= task.id %>"
    class="group transition-all duration-150 <%= 'opacity-50' if is_done %>"
    style="position:relative;padding:12px 14px 12px <%= accent_color ? '18px' : '14px' %>;background:#ffffff;border-radius:10px;border:1px solid #e5e7eb;box-shadow:0 1px 2px rgba(15,23,42,0.04)"
    onmouseenter="this.style.borderColor='#bfdbfe';this.style.boxShadow='0 8px 24px rgba(15,23,42,0.08)'"
    onmouseleave="this.style.borderColor='#e5e7eb';this.style.boxShadow='0 1px 2px rgba(15,23,42,0.04)'"
    data-task-id="<%= task.id %>"
    data-task-column-id="<%= task.board_column_id %>"
    data-task-position="<%= task.position %>">

  <% if accent_color %>
    <div aria-hidden="true" style="position:absolute;left:0;top:8px;bottom:8px;width:4px;border-radius:0 999px 999px 0;background:<%= accent_color %>"></div>
  <% end %>

  <div class="flex items-start gap-2">
    <div class="min-w-0 flex-1">
      <div class="task-drag-handle"
           title="Karte ziehen"
           style="display:flex;align-items:center;justify-content:center;width:100%;height:14px;margin:-4px 0 6px;cursor:grab;color:#9ca3af;border-radius:8px">
        <div style="width:36px;height:4px;border-radius:999px;background:#e5e7eb"></div>
      </div>

      <%= link_to board_task_path(task.board, task), class: "block select-none", data: { turbo_frame: "task_panel" } do %>
        <div style="font-size:13px;font-weight:600;color:<%= is_done ? '#9ca3af' : '#1f2937' %>;line-height:1.35;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
          <%= task.name %>
        </div>
      <% end %>
    </div>

    <% if internal_user %>
      <details class="relative" data-controller="dropdown">
        <summary class="flex h-7 w-7 cursor-pointer list-none items-center justify-center rounded-lg text-content-muted hover:bg-bg-hover hover:text-content" aria-label="Kartenaktionen">
          <span class="text-lg leading-none">...</span>
        </summary>
        <div class="absolute right-0 top-8 z-50 min-w-[190px] rounded-xl border border-border bg-bg-card p-1.5 shadow-lg">
          <%= link_to "Karte bearbeiten", board_task_path(task.board, task), class: "block rounded-lg px-3 py-2 text-sm font-medium text-content-secondary hover:bg-bg-hover", data: { turbo_frame: "task_panel" } %>
          <%= button_to "Karte duplizieren", duplicate_board_task_path(task.board, task), method: :post, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-content-secondary hover:bg-bg-hover cursor-pointer" %>
          <%= button_to "Karte archivieren", archive_board_task_path(task.board, task), method: :patch, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-content-secondary hover:bg-bg-hover cursor-pointer" %>
          <div class="my-1 h-px bg-border"></div>
          <%= button_to "Karte löschen", board_task_path(task.board, task), method: :delete, data: { turbo_confirm: "Möchtest du diese Karte wirklich löschen?" }, class: "w-full rounded-lg px-3 py-2 text-left text-sm font-semibold text-status-error hover:bg-red-50 cursor-pointer" %>
        </div>
      </details>
    <% end %>
  </div>

  <% subtask_total = task.respond_to?(:subtasks) ? task.subtasks.size : 0 %>
  <% subtask_done = subtask_total > 0 ? task.subtasks.count(&:done?) : 0 %>
  <% if task.priority != "none" || subtask_total > 0 %>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px">
      <% if task.priority != "none" %>
        <span style="font-size:10px;font-weight:600;color:#6b7280"><%= task.priority.humanize %></span>
      <% end %>
      <% if subtask_total > 0 %>
        <div style="display:flex;align-items:center;gap:4px">
          <span style="font-size:10px;font-weight:500;color:#6b7280">☐ <%= subtask_done %>/<%= subtask_total %></span>
          <div style="width:32px;height:3px;border-radius:2px;background:#e5e7eb;overflow:hidden">
            <div style="height:100%;border-radius:2px;width:<%= subtask_total > 0 ? (subtask_done.to_f / subtask_total * 100).round : 0 %>%;opacity:0.7" class="bg-<%= board_color %>-500"></div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</li>
