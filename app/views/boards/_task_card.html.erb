<% has_current_user = defined?(current_user) && current_user %>
<% internal_user = has_current_user && internal_workspace_member? %>
<% can_manage_card = has_current_user && current_workspace_membership.present? %>
<% board_color = task.board.color || "red" %>
<% accent_color = task.color_hex %>
<li id="task_<%= task.id %>"
    class="group cursor-pointer transition-all duration-150"
    style="position:relative;padding:16px 16px 15px <%= accent_color ? '20px' : '16px' %>;background:#ffffff;border-radius:12px;border:1px solid #e5e7eb;box-shadow:0 1px 2px rgba(15,23,42,0.05)"
    onmouseenter="this.style.borderColor='#bfdbfe';this.style.boxShadow='0 10px 26px rgba(15,23,42,0.08)'"
    onmouseleave="this.style.borderColor='#e5e7eb';this.style.boxShadow='0 1px 2px rgba(15,23,42,0.05)'"
    data-controller="task-card"
    data-action="click->task-card#open"
    data-task-card-url-value="<%= board_task_path(task.board, task) %>"
    data-task-id="<%= task.id %>"
    data-task-column-id="<%= task.board_column_id %>"
    data-task-position="<%= task.position %>">

  <% if accent_color %>
    <div aria-hidden="true" style="position:absolute;left:0;top:12px;bottom:12px;width:4px;border-radius:0 999px 999px 0;background:<%= accent_color %>"></div>
  <% end %>

  <% if internal_user %>
    <div class="task-drag-handle"
         data-no-card-open="true"
         title="Karte ziehen"
         style="display:flex;align-items:center;justify-content:center;width:100%;height:16px;margin:-6px 0 8px;cursor:grab;color:#9ca3af;border-radius:8px">
      <div style="width:42px;height:4px;border-radius:999px;background:#e5e7eb"></div>
    </div>
  <% end %>

  <div class="flex items-start gap-3">
    <div class="min-w-0 flex-1 pr-1">
      <div class="task-card-title" style="font-size:15.5px;font-weight:650;color:#1f2937;line-height:1.4;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
        <%= task.name %>
      </div>
    </div>

    <% if can_manage_card %>
      <div class="relative shrink-0" data-controller="dropdown" data-dropdown-portal-value="true" data-no-card-open="true">
        <button type="button"
                data-dropdown-target="button"
                data-action="click->dropdown#toggle"
                aria-expanded="false"
                aria-label="Kartenaktionen"
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-transparent text-content-muted transition-colors hover:border-border hover:bg-bg-hover hover:text-content">
          <span class="text-xl leading-none" aria-hidden="true">...</span>
        </button>
        <div data-dropdown-target="menu"
             class="hidden z-[220] min-w-[210px] rounded-xl border border-border bg-bg-card p-1.5 shadow-[0_18px_45px_rgba(15,23,42,0.16)]">
          <%= link_to "Karte bearbeiten", board_task_path(task.board, task), class: "block rounded-lg px-3 py-2.5 text-sm font-semibold text-content-secondary hover:bg-bg-hover", data: { turbo_frame: "task_panel" } %>
          <%= button_to "Karte duplizieren", duplicate_board_task_path(task.board, task), method: :post, class: "w-full rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-content-secondary hover:bg-bg-hover cursor-pointer" %>
          <%= button_to "Karte archivieren", archive_board_task_path(task.board, task), method: :patch, class: "w-full rounded-lg px-3 py-2.5 text-left text-sm font-semibold text-content-secondary hover:bg-bg-hover cursor-pointer" %>
          <div class="my-1 h-px bg-border"></div>
          <%= button_to "Karte löschen", board_task_path(task.board, task), method: :delete, data: { turbo_confirm: "Möchtest du diese Karte wirklich löschen?" }, class: "w-full rounded-lg px-3 py-2.5 text-left text-sm font-bold text-status-error hover:bg-red-50 cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <% subtask_total = task.respond_to?(:subtasks) ? task.subtasks.size : 0 %>
  <% subtask_done = subtask_total > 0 ? task.subtasks.count(&:done?) : 0 %>
  <% if subtask_total > 0 %>
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:12px">
      <div style="display:flex;align-items:center;gap:6px">
        <span aria-label="<%= subtask_done %> von <%= subtask_total %> Assets erledigt" style="font-size:12px;font-weight:700;color:<%= subtask_done == subtask_total ? '#15803d' : '#6b7280' %>">✓ <%= subtask_done %>/<%= subtask_total %></span>
        <div style="width:38px;height:4px;border-radius:2px;background:#e5e7eb;overflow:hidden"><div style="height:100%;border-radius:2px;width:<%= (subtask_done.to_f / subtask_total * 100).round %>%;opacity:.75;background:<%= accent_color || board_hex_color(task.board) %>"></div></div>
      </div>
    </div>
  <% end %>
</li>
