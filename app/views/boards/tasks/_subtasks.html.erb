<% subtasks = task.subtasks.reload %>

<div id="task_<%= task.id %>_subtasks" class="flex flex-col gap-2">
  <% done_count = subtasks.count(&:done?) %>
  <div class="mb-1 flex items-center justify-between"><h2 class="text-[13px] font-bold text-content">Assetliste</h2><span class="text-xs font-semibold text-content-muted"><%= done_count %>/<%= subtasks.size %></span></div>
  <div class="mb-2 h-1 overflow-hidden rounded-full bg-border"><div class="h-full rounded-full" style="width:<%= subtasks.any? ? (done_count.to_f / subtasks.size * 100).round : 0 %>%;background:<%= board_hex_color(board) %>"></div></div>
  <% subtasks.each do |subtask| %>
    <div class="flex items-center gap-2 rounded-xl border border-border bg-bg-surface px-3 py-2">
      <%= form_with url: board_task_subtask_path(board, task, subtask), method: :patch, scope: :subtask, class: "contents" do |form| %>
        <%= form.check_box :done, { checked: subtask.done?, class: "h-4 w-4 shrink-0 rounded border-border text-accent focus:ring-accent", onchange: "this.form.requestSubmit()", aria: { label: "#{subtask.title} erledigt" } }, "true", "false" %>
      <% end %>
      <%= form_with url: board_task_subtask_path(board, task, subtask), method: :patch, scope: :subtask, class: "min-w-0 flex-1" do |form| %>
        <%= form.text_field :title, value: subtask.title, aria: { label: "Assetname" },
            class: "w-full bg-transparent text-sm font-medium outline-none #{subtask.done? ? 'text-content-muted line-through' : 'text-content-secondary'}",
            onchange: "this.form.requestSubmit()" %>
      <% end %>
      <%= button_to "Entfernen", board_task_subtask_path(board, task, subtask), method: :delete,
          class: "shrink-0 rounded-md px-2 py-1 text-xs font-semibold text-content-muted transition-colors hover:bg-red-50 hover:text-red-700", data: { turbo_confirm: "Asset aus der Liste entfernen?" } %>
    </div>
  <% end %>

  <%= form_with url: board_task_subtasks_path(board, task), scope: :subtask, class: "mt-1 flex gap-2" do |form| %>
    <%= form.text_field :title, placeholder: "Format oder Asset hinzufügen…", aria: { label: "Asset hinzufügen" },
        class: "min-h-10 min-w-0 flex-1 rounded-lg border border-dashed border-border bg-transparent px-3 text-sm text-content outline-none placeholder:text-content-muted focus:border-accent focus:ring-2 focus:ring-accent" %>
    <%= form.submit "Hinzufügen", class: "min-h-10 rounded-lg border border-border bg-bg-elevated px-3 text-xs font-bold text-content-secondary transition-colors hover:bg-bg-hover" %>
  <% end %>
</div>
