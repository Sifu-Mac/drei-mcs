<% if @task.saved_change_to_board_column_id? %>
  <% old_column_id = @task.board_column_id_before_last_save %>
  <% new_column_id = @task.board_column_id %>
  <%= turbo_stream.remove "task_#{@task.id}" %>
  <%= turbo_stream.prepend "column-#{new_column_id}" do %>
    <%= render "boards/task_card", task: @task %>
  <% end %>
  <% [old_column_id, new_column_id].uniq.each do |column_id| %>
    <% column_count = @board.tasks.where(board_column_id: column_id).count %>
    <%= turbo_stream.replace "column-#{column_id}-count" do %>
      <span id="column-<%= column_id %>-count" class="ml-auto text-xs text-content-secondary bg-bg-elevated px-1.5 py-0.5 rounded"><%= column_count %></span>
    <% end %>
  <% end %>
<% else %>
  <%= turbo_stream.replace "task_#{@task.id}" do %>
    <%= render "boards/task_card", task: @task %>
  <% end %>
<% end %>

<%= turbo_stream.replace "task-activities-#{@task.id}" do %>
  <%= render "shared/task_activities", task: @task %>
<% end %>
