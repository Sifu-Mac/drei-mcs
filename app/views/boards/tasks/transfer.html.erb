<% copy_mode = @transfer_mode == "copy" %>
<% content_for :title, "Karte #{copy_mode ? "kopieren" : "verschieben"} - #{app_name}" %>

<main class="mx-auto max-w-xl px-4 py-10">
  <%= link_to "← Zurück zum Board", board_path(@board), class: "text-sm font-semibold text-content-muted hover:text-content" %>
  <section class="mt-5 rounded-2xl border border-border bg-bg-card p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[.08em] text-content-muted">Karte <%= copy_mode ? "kopieren" : "verschieben" %></p>
    <h1 class="mt-2 text-2xl font-extrabold text-content"><%= @task.name %></h1>
    <p class="mt-3 text-sm leading-6 text-content-secondary">
      <% if copy_mode %>
        Eine vollständige Kopie inklusive Assetliste, Kommentaren, Zitaten und Kommentar-Bildern wird erstellt.
      <% else %>
        Die bestehende Karte inklusive aller Inhalte wird in das Zielboard verschoben.
      <% end %>
    </p>

    <%= form_with url: copy_mode ? copy_to_board_board_task_path(@board, @task) : move_to_board_board_task_path(@board, @task), method: copy_mode ? :post : :patch, scope: :transfer, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :destination, "Zielboard und Zielspalte", class: "mb-2 block text-sm font-bold text-content" %>
        <%= form.select :destination,
          grouped_options_for_select(@transfer_boards.map { |board| [board.name, board.board_columns.ordered.map { |column| [column.name, "#{board.id}:#{column.id}"] }] }),
          { prompt: "Bitte auswählen" },
          required: true,
          class: "w-full rounded-xl border border-border bg-bg-surface px-3 py-2.5 text-sm font-semibold text-content focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>
      <% unless copy_mode %>
        <p class="rounded-xl border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">Die Karte verschwindet danach aus <strong><%= @board.name %></strong>.</p>
      <% end %>
      <div class="flex justify-end gap-3">
        <%= link_to "Abbrechen", board_path(@board), class: "rounded-lg px-4 py-2 text-sm font-bold text-content-secondary hover:bg-bg-hover" %>
        <%= form.submit(copy_mode ? "Karte kopieren" : "Karte verschieben", data: (copy_mode ? {} : { turbo_confirm: "Karte wirklich in ein anderes Board verschieben?" }), class: "rounded-lg bg-accent px-4 py-2 text-sm font-bold text-content-inverse hover:bg-accent-hover cursor-pointer" ) %>
      </div>
    <% end %>
  </section>
</main>
