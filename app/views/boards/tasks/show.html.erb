<% content_for :title, "#{@task.name} - #{app_name}" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "task_panel" do %>
    <%= render "boards/tasks/panel", task: @task %>
  <% end %>
<% else %>
  <div class="py-6 space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <%= link_to "← Zurück zum Board", board_path(@board), class: "text-xs text-content-muted hover:text-content transition-colors" %>
        <h1 class="mt-2 text-2xl font-extrabold text-content font-display"><%= @task.name %></h1>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-xs text-content-muted"><%= @task.board.icon %> <%= @task.board.name %></div>
        <%= button_to "Karte löschen",
            board_task_path(@board, @task),
            method: :delete,
            data: { turbo_confirm: "Task wirklich löschen?" },
            form: { data: { turbo: false } },
            class: "px-3 py-1.5 text-xs font-semibold rounded-md bg-red-500/12 text-red-400 border border-red-500/20 hover:bg-red-500/18 transition-colors cursor-pointer" %>
      </div>
    </div>

    <%= form_with model: [@board, @task], class: "space-y-5", data: { turbo: false }, html: { multipart: true } do |form| %>
      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Spalte</label>
          <%= form.select :board_column_id,
              @board.board_columns.ordered.map { |column| [column.name, column.id] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Priorität</label>
          <%= form.select :priority,
              Task.priorities.keys.map { |key| [key.humanize, key] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Farbe</label>
          <%= form.select :color,
              Task::COLOR_LABELS.map { |key, label| [label, key] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-content-muted mb-2">Beschreibung / Anweisungen</label>
        <%= form.text_area :description,
            rows: 10,
            placeholder: "Beschreibe Details und Anweisungen hier...",
            class: "w-full bg-bg-elevated border border-border rounded-xl px-4 py-3 text-sm text-content-secondary" %>
      </div>

      <div class="flex justify-end">
        <%= form.submit "Karte speichern", class: "px-4 py-2 text-sm font-semibold rounded-md bg-accent text-content-inverse hover:bg-accent-hover transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <div class="space-y-3">
      <h2 class="text-sm font-bold text-content">Kommentare</h2>
      <%= render "boards/comments/list", task: @task %>
      <%= render "boards/comments/form", board: @board, task: @task %>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-bold text-content">Aktivität</h2>
      <%= render "shared/task_activities", task: @task %>
    </div>
  </div>
<% end %>
