<% content_for :title, "#{@task.name} - #{app_name}" %>

<% if turbo_frame_request? %>
  <%= turbo_frame_tag "task_panel" do %>
    <%= render "boards/tasks/panel", task: @task %>
  <% end %>
<% else %>
  <div class="py-6 space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div>
        <%= link_to "← Back to board", board_path(@board), class: "text-xs text-content-muted hover:text-content transition-colors" %>
        <h1 class="mt-2 text-2xl font-extrabold text-content font-display"><%= @task.name %></h1>
      </div>
      <div class="flex items-center gap-3">
        <div class="text-xs text-content-muted"><%= @task.board.icon %> <%= @task.board.name %></div>
        <%= button_to "Karte löschen",
            board_task_path(@board, @task),
            method: :delete,
            data: { turbo_confirm: "Task wirklich löschen?" },
            form: { data: { turbo: false } },
            class: "px-3 py-1.5 text-xs font-semibold rounded-md bg-red-500/12 text-red-400 border border-red-500/20 hover:bg-red-500/18 transition-colors cursor-pointer" %>
      </div>
    </div>

    <%= form_with model: [@board, @task], class: "space-y-5", data: { turbo: false }, html: { multipart: true } do |form| %>
      <div class="space-y-2">
        <label class="block text-xs font-semibold text-content-muted">Cover image</label>
        <% if @task.cover_image.attached? %>
          <div class="overflow-hidden rounded-xl border border-border bg-bg-elevated">
            <%= image_tag @task.cover_image, alt: "", class: "block w-full h-auto max-h-[520px] object-contain" %>
          </div>
        <% else %>
          <div class="h-48 rounded-xl border border-border bg-bg-elevated flex items-center justify-center text-content-muted text-3xl" aria-hidden="true">▧</div>
        <% end %>
        <%= form.file_field :cover_image,
            accept: "image/jpeg,image/png,image/webp,image/gif",
            class: "block w-full text-xs text-content-secondary file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-bg-elevated file:text-content-secondary hover:file:bg-bg-hover file:cursor-pointer" %>
        <% if @task.errors[:cover_image].any? %>
          <div class="text-xs text-status-error"><%= @task.errors[:cover_image].join(", ") %></div>
        <% end %>
      </div>

      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Status</label>
          <%= form.select :status,
              Task::STATUS_LABELS.map { |key, label| [label, key] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Owner</label>
          <%= form.select :owner,
              Task::OWNER_LABELS.map { |key, label| [label, key] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-content-muted mb-2">Priorität</label>
          <%= form.select :priority,
              Task.priorities.keys.map { |key| [key.humanize, key] },
              {},
              class: "w-full bg-bg-elevated border border-border rounded-lg px-3 py-2 text-sm text-content" %>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-content-muted mb-2">Description / instructions</label>
        <%= form.text_area :description,
            rows: 10,
            placeholder: "Write the task details and instructions here...",
            class: "w-full bg-bg-elevated border border-border rounded-xl px-4 py-3 text-sm text-content-secondary" %>
      </div>

      <div class="flex justify-end">
        <%= form.submit "Karte speichern", class: "px-4 py-2 text-sm font-semibold rounded-md bg-accent text-content-inverse hover:bg-accent-hover transition-colors cursor-pointer" %>
      </div>
    <% end %>

    <div class="space-y-3">
      <h2 class="text-sm font-bold text-content">Kommentare</h2>
      <%= render "boards/comments/list", task: @task %>
      <%= render "boards/comments/form", board: @board, task: @task %>
    </div>

    <div class="space-y-3">
      <h2 class="text-sm font-bold text-content">Activity</h2>
      <%= render "shared/task_activities", task: @task %>
    </div>
  </div>
<% end %>
