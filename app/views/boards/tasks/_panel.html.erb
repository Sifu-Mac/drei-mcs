<% board_columns = @board.board_columns.ordered %>
<% board_color_hex = board_hex_color(@board) %>

<div data-controller="task-modal"
     data-task-modal-task-id-value="<%= task.id %>"
     data-task-modal-update-url-value="<%= board_task_path(@board, task) %>"
     data-task-modal-delete-url-value="<%= board_task_path(@board, task) %>">
  <div data-task-modal-target="backdrop" data-action="click->task-modal#close"
       class="hidden opacity-0 transition-opacity duration-200 ease-out"
       style="position:fixed;inset:0;background:rgba(15,23,42,.28);backdrop-filter:blur(3px);z-index:200"></div>

  <section data-task-modal-target="modal"
           aria-label="Karte bearbeiten"
           class="hidden opacity-0 fixed inset-0 z-[201] flex flex-col overflow-hidden bg-bg-surface transition-opacity duration-200 ease-out md:inset-auto md:top-1/2 md:left-1/2 md:h-[min(86vh,900px)] md:w-[min(860px,calc(100vw-32px))] md:-translate-x-1/2 md:-translate-y-1/2 md:rounded-[18px] md:border md:border-border md:shadow-[0_30px_80px_rgba(15,23,42,0.18)]">
    <header class="flex items-center justify-between gap-3 border-b border-border px-4 py-3 md:px-5 md:py-4">
      <button type="button" data-action="click->task-modal#deleteTask"
              class="min-h-10 rounded-lg border border-red-500/25 bg-red-500/10 px-3 text-xs font-bold text-red-700 transition-colors hover:bg-red-500/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500">
        Karte löschen
      </button>
      <button type="button" data-action="click->task-modal#close" aria-label="Karte schließen"
              class="flex h-9 w-9 items-center justify-center rounded-full border border-border bg-bg-elevated text-base text-content-muted transition-colors hover:bg-bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">✕</button>
    </header>

    <div class="flex-1 overflow-y-auto px-4 py-5 md:px-7 md:py-7">
      <%= form_with model: task, url: board_task_path(@board, task), method: :patch,
          id: dom_id(task, :edit), class: "flex flex-col gap-7", data: { task_modal_target: "form" } do |form| %>
        <section>
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[.08em] text-content-muted">Karte</p>
          <%= form.text_field :name, placeholder: "Kartentitel", readonly: true,
              class: "w-full cursor-text rounded-lg border border-transparent bg-transparent px-2 py-1 text-xl font-extrabold leading-tight text-content outline-none transition-colors hover:bg-bg-elevated focus:border-border focus:bg-bg-surface focus:ring-2 focus:ring-accent",
              data: { task_modal_target: "nameField", action: "click->task-modal#editField input->task-modal#scheduleAutoSave keydown->task-modal#handleInlineKeydown blur->task-modal#finishInlineEdit" } %>
        </section>

        <section>
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[.08em] text-content-muted">Beschreibung</p>
          <%= form.text_area :description, placeholder: "Beschreibung hinzufügen…", rows: 7, readonly: true,
              class: "min-h-[168px] w-full cursor-text resize-y rounded-xl border border-transparent bg-bg-elevated p-4 text-[14px] leading-6 text-content-secondary outline-none transition-colors hover:border-border focus:border-border focus:bg-bg-surface focus:ring-2 focus:ring-accent",
              data: { task_modal_target: "descriptionField", action: "click->task-modal#editField input->task-modal#scheduleAutoSave keydown->task-modal#handleInlineKeydown blur->task-modal#finishInlineEdit" } %>
        </section>

        <section class="rounded-2xl border border-border bg-bg-elevated p-4 md:p-5">
          <h2 class="mb-4 text-[13px] font-bold text-content">Details</h2>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="space-y-2" data-controller="dropdown">
              <span class="text-xs font-medium text-content-muted">Spalte</span>
              <button type="button" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-expanded="false"
                      class="flex min-h-11 w-full items-center justify-between gap-2 rounded-lg border border-border bg-bg-surface px-3 py-2 text-left text-sm font-semibold text-content-secondary transition-colors hover:bg-bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">
                <span data-task-modal-target="statusLabel"><%= task.board_column.name %></span><span aria-hidden="true">⌄</span>
              </button>
              <div data-dropdown-target="menu" class="hidden z-10 mt-1 w-full rounded-xl border border-border bg-bg-dropdown p-1 shadow-[0_12px_40px_rgba(15,23,42,.12)]">
                <% board_columns.each do |column| %>
                  <button type="button" data-action="click->task-modal#changeStatus" data-column-id="<%= column.id %>" data-status-label="<%= column.name %>"
                          class="block w-full rounded-lg px-3 py-2 text-left text-sm font-medium text-content-secondary hover:bg-bg-hover"><%= column.name %></button>
                <% end %>
              </div>
            </div>
            <div class="space-y-2">
              <label class="text-xs font-medium text-content-muted" for="task_color_<%= task.id %>">Farbe</label>
              <%= select_tag "task[color]", options_for_select(Task::COLOR_LABELS.map { |key, label| [label, key] }, task.color),
                  form: dom_id(task, :edit), id: "task_color_#{task.id}",
                  class: "h-11 w-full rounded-lg border border-border bg-bg-surface px-3 text-sm font-semibold text-content outline-none focus:ring-2 focus:ring-accent",
                  data: { action: "change->task-modal#scheduleAutoSave" } %>
            </div>
          </div>
        </section>
        <%= form.submit "Speichern", class: "hidden", data: { task_modal_target: "submitButton" } %>
      <% end %>

      <section class="mt-7" aria-labelledby="assetliste-heading">
        <%= render "boards/tasks/subtasks", task: task, board: @board %>
      </section>

      <section class="mt-7 rounded-2xl border border-border bg-bg-elevated p-4 md:p-5">
        <h2 class="mb-4 text-[13px] font-bold text-content">Kommentare</h2>
        <div class="flex flex-col gap-3"><%= render "boards/comments/list", task: task %><%= render "boards/comments/form", board: @board, task: task %></div>
      </section>
    </div>

    <footer class="flex items-center justify-between gap-3 border-t border-border bg-bg-surface px-4 py-3 md:px-5">
      <span data-task-modal-target="saveStatus" role="status" aria-live="polite" class="text-[11px] font-semibold text-content-muted">Klicken zum Bearbeiten</span>
      <button type="button" data-action="click->task-modal#close" class="min-h-10 rounded-lg border border-border bg-bg-elevated px-4 text-sm font-bold text-content-secondary transition-colors hover:bg-bg-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent">Schließen</button>
    </footer>
  </section>
</div>
