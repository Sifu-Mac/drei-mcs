<%# Task edit modal for kanban board %>
<%
  status_labels = Task::STATUS_LABELS
  status_dot_colors = Task::STATUS_COLORS
  owner_labels = Task::OWNER_LABELS
  priority_levels = [
    { id: "none", dots: 1, color: "#9ca3af" },
    { id: "low", dots: 2, color: "#60a5fa" },
    { id: "medium", dots: 3, color: "#fbbf24" },
    { id: "high", dots: 4, color: "#ef4444" },
  ]
  board_color_hex = board_hex_color(@board)
%>

<div data-controller="task-modal"
     data-task-modal-task-id-value="<%= task.id %>"
     data-task-modal-update-url-value="<%= board_task_path(@board, task) %>"
     data-task-modal-assign-url-value="<%= assign_board_task_path(@board, task) %>"
     data-task-modal-unassign-url-value="<%= unassign_board_task_path(@board, task) %>"
     data-task-modal-delete-url-value="<%= board_task_path(@board, task) %>">
  <!-- Backdrop -->
  <div data-task-modal-target="backdrop"
       data-action="click->task-modal#close"
       style="position:fixed;inset:0;background:rgba(15,23,42,0.25);backdrop-filter:blur(3px);z-index:200"
       class="hidden opacity-0 transition-opacity duration-200 ease-out">
  </div>
  <!-- Centered Modal -->
  <div data-task-modal-target="modal"
       class="hidden opacity-0 transition-all duration-200 ease-out fixed inset-0 z-[201] flex flex-col bg-bg-surface md:inset-auto md:top-1/2 md:left-1/2 md:h-[min(86vh,900px)] md:w-[min(920px,calc(100vw-32px))] md:-translate-x-1/2 md:-translate-y-1/2 md:scale-95 md:rounded-[18px] md:border md:border-border md:shadow-[0_30px_80px_rgba(15,23,42,0.18)] overflow-hidden">

    <!-- Header — status pill + close -->
    <div class="px-4 py-3 md:px-5 md:py-4 border-b border-border flex items-center justify-between gap-3 shrink-0">
      <div data-task-modal-target="statusPill" class="text-[11px] font-bold text-content-secondary bg-bg-elevated px-3 py-1 rounded-md border border-border">
        <%= status_labels[task.status] %>
      </div>
      <button type="button"
              data-action="click->task-modal#close"
              class="h-9 w-9 rounded-full bg-bg-elevated border border-border text-content-muted text-base cursor-pointer flex items-center justify-center hover:bg-bg-hover transition-colors">✕</button>
    </div>

    <!-- Scrollable content -->
    <div class="flex-1 overflow-y-auto px-4 py-4 md:px-5 md:py-5 md:pb-8 flex flex-col gap-5 md:gap-6">

      <%# === Auto-save form: title, notes, priority only === %>
      <%= form_with model: task, url: board_task_path(@board, task), method: :patch, id: dom_id(task, :edit), class: "flex flex-col gap-5", data: { task_modal_target: "form" }, html: { multipart: true } do |form| %>
        <%= form.hidden_field :priority, value: task.priority, data: { task_modal_target: "priorityField" } %>

        <!-- Cover image -->
        <div class="space-y-2">
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-[#5f5f67]">Cover image</div>
          <% if task.cover_image.attached? %>
            <div style="border-radius:16px;overflow:hidden;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08)">
              <%= image_tag task.cover_image, alt: "", style: "display:block;width:100%;height:auto;max-height:380px;object-fit:contain" %>
            </div>
          <% else %>
            <div aria-hidden="true" style="height:180px;border-radius:16px;background:linear-gradient(135deg,rgba(255,255,255,0.055),rgba(255,255,255,0.018));border:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center;color:#555;font-size:28px">
              ▧
            </div>
          <% end %>
          <%= form.file_field :cover_image,
              accept: "image/jpeg,image/png,image/webp,image/gif",
              class: "block w-full text-xs text-[#888] file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-white/8 file:text-[#d0d0d5] hover:file:bg-white/12 file:cursor-pointer",
              data: { action: "change->task-modal#save" } %>
          <% if task.errors[:cover_image].any? %>
            <div style="font-size:11px;font-weight:500;color:#ef4444"><%= task.errors[:cover_image].join(", ") %></div>
          <% end %>
        </div>

        <!-- Title -->
        <div class="space-y-2">
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-content-muted">Task</div>
          <%= form.text_field :name,
              placeholder: "Task title",
              class: "w-full bg-transparent border-0 outline-none p-0 text-xl md:text-[20px] font-extrabold leading-tight text-content",
              data: { task_modal_target: "nameField", action: "input->task-modal#scheduleAutoSpeichern" } %>
        </div>

        <!-- Notes -->
        <div class="space-y-2">
          <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-content-muted">Notes</div>
          <%= form.text_area :description,
              placeholder: "Add notes...",
              class: "w-full min-h-[140px] md:min-h-[120px] p-3.5 rounded-xl border border-border bg-bg-elevated text-[14px] text-content-secondary resize-y outline-none leading-6 placeholder:text-content-muted focus:ring-2 focus:ring-accent",
              data: { task_modal_target: "descriptionField", action: "input->task-modal#scheduleAutoSpeichern" } %>
        </div>

        <!-- Hidden submit button (triggered programmatically) -->
        <%= form.submit "Speichern", class: "hidden", data: { task_modal_target: "submitButton" } %>
      <% end %>

      <%# === Details section: status, priority, agent — outside form === %>
      <div class="rounded-2xl border border-border bg-bg-elevated p-4 md:p-5">
        <div class="text-[13px] font-bold text-content mb-4">Details</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-4">

        <!-- Status row -->
        <div class="space-y-2" data-controller="dropdown">
          <span class="text-xs font-medium text-content-muted">Status</span>
          <div class="relative w-full md:w-auto">
            <button type="button" data-action="click->dropdown#toggle" data-dropdown-target="button" aria-expanded="false"
                    class="w-full md:w-auto min-h-11 flex items-center justify-between gap-2 px-3 py-2 rounded-lg cursor-pointer bg-bg-surface border border-border transition-all text-left hover:bg-bg-hover">
              <div data-task-modal-target="statusDot" style="width:6px;height:6px;border-radius:50%;background:<%= status_dot_colors[task.status] %>"></div>
              <span data-task-modal-target="statusLabel" class="text-xs font-semibold text-[#ccc] flex-1"><%= status_labels[task.status] %></span>
              <svg width="10" height="10" viewBox="0 0 16 16" fill="none" style="opacity:0.3">
                <path d="M4 6L8 10L12 6" stroke="#6b7280" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div data-dropdown-target="menu" class="hidden absolute top-[calc(100%+4px)] right-0 w-full md:w-[180px] p-1 rounded-[10px] bg-bg-dropdown border border-border shadow-[0_12px_40px_rgba(15,23,42,0.12)] z-10">
              <% status_labels.each do |status_key, status_label| %>
                <button type="button"
                        data-action="click->task-modal#changeStatus"
                        data-status="<%= status_key %>"
                        data-status-label="<%= status_label %>"
                        data-status-dot="<%= status_dot_colors[status_key] %>"
                        style="display:flex;align-items:center;gap:9px;width:100%;padding:8px 10px;border-radius:7px;background:<%= task.status == status_key ? '#eaf1ff' : 'transparent' %>;border:none;cursor:pointer;transition:background 0.1s;text-align:left"
                        onmouseenter="if(!this.dataset.active)this.style.background='#eef2ff'"
                        onmouseleave="if(!this.dataset.active)this.style.background='transparent'">
                  <div style="width:7px;height:7px;border-radius:50%;background:<%= status_dot_colors[status_key] %>"></div>
                  <span style="font-size:12px;font-weight:600;color:<%= task.status == status_key ? '#1e5eff' : '#4b5563' %>;flex:1"><%= status_label %></span>
                  <% if task.status == status_key %>
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="<%= status_dot_colors[status_key] %>" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <% end %>
                </button>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Priorität row -->
        <%
          priority_cycle = %w[none low medium high]
          priority_config = {
            "none"   => { dots: 0, color: "#9ca3af", bg: "#ffffff",                border: "#e5e7eb" },
            "low"    => { dots: 1, color: "#60a5fa",  bg: "rgba(96,165,250,0.10)",   border: "rgba(96,165,250,0.25)" },
            "medium" => { dots: 2, color: "#fbbf24",  bg: "rgba(251,191,36,0.10)",   border: "rgba(251,191,36,0.25)" },
            "high"   => { dots: 3, color: "#ef4444",  bg: "rgba(239,68,68,0.10)",    border: "rgba(239,68,68,0.25)" },
          }
          current_p = priority_config[task.priority] || priority_config["none"]
        %>
        <div class="space-y-2">
          <span class="text-xs font-medium text-content-muted">Priorität</span>
          <button type="button"
                  data-action="click->task-modal#cyclePriorität"
                  data-task-modal-target="priorityButton"
                  data-priority-value="<%= task.priority %>"
                  class="w-full md:w-[100px] h-11 md:h-[30px] rounded-lg md:rounded-[7px] cursor-pointer flex items-center justify-center gap-2 transition-all"
                  style="background:<%= current_p[:bg] %>;border:1px solid <%= current_p[:border] %>">
            <% if current_p[:dots] == 0 %>
              <div style="width:5px;height:5px;border-radius:50%;background:#9ca3af;opacity:0.6"></div>
            <% else %>
              <% current_p[:dots].times do %>
                <div style="width:5px;height:5px;border-radius:50%;background:<%= current_p[:color] %>"></div>
              <% end %>
            <% end %>
            <span data-task-modal-target="priorityLabel" style="font-size:12px;font-weight:700;color:#374151;line-height:1"><%= task.priority == "none" ? "None" : task.priority.titleize %></span>
          </button>
        </div>

        <!-- Owner row -->
        <div class="space-y-2">
          <span class="text-xs font-medium text-content-muted">Owner</span>
          <%= select_tag "task[owner]",
              options_for_select(owner_labels.map { |key, label| [label, key] }, task.owner),
              form: dom_id(task, :edit),
              id: nil,
              class: "w-full h-11 px-3 rounded-lg bg-bg-surface border border-border text-content text-sm font-semibold outline-none focus:ring-2 focus:ring-accent",
              data: { action: "change->task-modal#scheduleAutoSpeichern" } %>
        </div>

        <!-- Agent row -->
        <div class="space-y-2">
          <span class="text-xs font-medium text-content-muted">Agent</span>
          <% if task.assigned_to_agent? %>
            <button type="button"
                    data-action="click->task-modal#toggleAgent"
                    class="w-full h-11 flex items-center justify-center gap-2 rounded-lg cursor-pointer transition-all"
                    style="background:rgba(251,191,36,0.1);border:1px solid rgba(251,191,36,0.2)">
              <span style="font-size:11px">🤖</span>
              <span style="font-size:11px;font-weight:600;color:#fbbf24">Zugewiesen</span>
            </button>
          <% else %>
            <% agent_connected = current_user.agent_last_active_at.present? %>
            <% if agent_connected %>
              <button type="button"
                      data-action="click->task-modal#toggleAgent"
                      class="w-full h-11 flex items-center justify-center gap-2 rounded-lg cursor-pointer transition-all"
                      style="background:#ffffff;border:1px solid #e5e7eb">
                <span style="font-size:11px">🤖</span>
                <span style="font-size:11px;font-weight:600;color:#4b5563">Zuweisen</span>
              </button>
            <% else %>
              <span class="w-full h-11 flex items-center justify-center gap-2 rounded-lg cursor-not-allowed"
                    style="background:#f9fafb;border:1px solid #e5e7eb">
                <span style="font-size:11px">🤖</span>
                <span style="font-size:11px;font-weight:600;color:#666">Zuweisung nicht verfügbar</span>
              </span>
            <% end %>
          <% end %>
        </div>
        </div>
      </div>

      <!-- Agent Status Banner -->
      <% if task.assigned_to_agent? && task.agent_claimed_at.present? %>
        <% agent_done = task.status == "done" || task.status == "review" %>
        <div style="padding:12px 14px;border-radius:10px;background:<%= agent_done ? 'rgba(52,211,153,0.05)' : 'rgba(251,191,36,0.05)' %>;border:1px solid <%= agent_done ? 'rgba(52,211,153,0.10)' : 'rgba(251,191,36,0.10)' %>;display:flex;align-items:center;gap:9px">
          <span style="font-size:16px">🤖</span>
          <div>
            <div style="font-size:12px;font-weight:600;color:<%= agent_done ? '#34d399' : '#fbbf24' %>">
              <%= agent_done ? 'Agent finished — needs review' : 'Agent is working on this' %>
            </div>
            <div style="font-size:11px;font-weight:500;color:#6b7280;margin-top:2px">
              <%= agent_done ? 'Änderungen prüfen, bevor die Karte erledigt wird' : 'Später erneut auf Updates prüfen' %>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Subtasks -->
      <% subtasks = task.subtasks %>
      <% if subtasks.any? %>
        <% done_count = subtasks.count(&:done?) %>
        <% total_count = subtasks.size %>
        <% progress = total_count > 0 ? (done_count.to_f / total_count * 100).round : 0 %>
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px">
            <div style="font-size:10px;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em">Subtasks</div>
            <span style="font-size:10px;font-weight:600;color:#6b7280"><%= done_count %>/<%= total_count %></span>
          </div>
          <div style="height:3px;border-radius:2px;background:#e5e7eb;margin-bottom:10px;overflow:hidden">
            <div style="height:100%;border-radius:2px;background:<%= board_color_hex %>;width:<%= progress %>%;opacity:0.8"></div>
          </div>
          <div id="task_<%= task.id %>_subtasks" style="display:flex;flex-direction:column;gap:3px">
            <% subtasks.each do |subtask| %>
              <%= button_to board_task_subtask_path(@board, task, subtask),
                  method: :patch,
                  params: { subtask: { done: !subtask.done? } },
                  style: "display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;background:#ffffff;border:1px solid #e5e7eb;cursor:pointer" do %>
                <% if subtask.done? %>
                  <div style="width:16px;height:16px;border-radius:4px;background:<%= board_color_hex %>;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    <svg width="9" height="9" viewBox="0 0 16 16" fill="none"><path d="M3 8.5L6.5 12L13 4" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </div>
                <% else %>
                  <div style="width:16px;height:16px;border-radius:4px;border:1.5px solid #cbd5e1;background:transparent;flex-shrink:0"></div>
                <% end %>
                <span style="font-size:12.5px;font-weight:500;color:<%= subtask.done? ? '#9ca3af' : '#374151' %>;<%= 'text-decoration:line-through' if subtask.done? %>"><%= subtask.title %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- Agent Suggestion Hint -->
      <% if task.agent_hint.present? %>
        <div style="padding:12px 14px;border-radius:10px;background:rgba(251,191,36,0.04);border:1px solid rgba(251,191,36,0.08);display:flex;align-items:flex-start;gap:9px">
          <span style="font-size:14px;margin-top:1px">💡</span>
          <div>
            <div style="font-size:12px;font-weight:600;color:#fbbf24;margin-bottom:2px">Suggestion</div>
            <div style="font-size:12px;font-weight:500;color:#4b5563;line-height:1.4"><%= task.agent_hint %></div>
          </div>
        </div>
      <% end %>

      <!-- Kommentare -->
      <div class="rounded-2xl border border-border bg-bg-elevated p-4 md:p-5">
        <div style="font-size:13px;font-weight:700;color:#1f2937;margin-bottom:14px">Kommentare</div>
        <div style="display:flex;flex-direction:column;gap:12px">
          <%= render "boards/comments/list", task: task %>
          <%= render "boards/comments/form", board: @board, task: task %>
        </div>
      </div>

      <!-- Activity Feed -->
      <div class="rounded-2xl border border-border bg-bg-elevated p-4 md:p-5">
        <div style="font-size:13px;font-weight:700;color:#1f2937;margin-bottom:14px">Activity</div>
        <%= render "shared/task_activities", task: task %>
      </div>
    </div>

    <div class="px-4 py-3 md:px-5 md:py-3.5 border-t border-border flex flex-col md:flex-row md:items-center md:justify-between gap-3 shrink-0 bg-bg-surface">
      <span data-task-modal-target="saveStatus" class="text-[11px] font-semibold text-[#666]">Auto-save active</span>
      <div class="flex items-center gap-2 md:gap-2.5 w-full md:w-auto">
        <button type="button"
                data-action="click->task-modal#deleteTask"
                class="flex-1 md:flex-none min-h-11 px-4 py-2.5 rounded-xl border border-red-500/20 bg-red-500/10 text-red-300 text-sm md:text-xs font-bold cursor-pointer hover:bg-red-500/15 transition-colors">
          Löschen
        </button>
        <button type="button"
                data-action="click->task-modal#close"
                class="flex-1 md:flex-none min-h-11 px-4 py-2.5 rounded-xl border border-border bg-bg-elevated text-content-secondary text-sm md:text-xs font-bold cursor-pointer hover:bg-bg-hover transition-colors">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
