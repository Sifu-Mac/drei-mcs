<%= turbo_stream.append "column-#{@task.board_column_id}" do %>
  <%= render "boards/task_card", task: @task %>
<% end %>

<%= turbo_stream.update "new_task_modal", "" %>

<% column_count = @board.tasks.where(board_column_id: @task.board_column_id).count %>
<%= turbo_stream.replace "column-#{@task.board_column_id}-count" do %>
  <span id="column-<%= @task.board_column_id %>-count" class="ml-auto text-xs text-content-secondary bg-bg-elevated px-1.5 py-0.5 rounded"><%= column_count %></span>
<% end %>
