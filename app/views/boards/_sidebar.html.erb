<% campaigns = defined?(@campaigns) && @campaigns ? @campaigns : current_user.current_workspace_campaigns.includes(:boards) %>
<% active_campaign_id = @active_campaign&.id || @board&.campaign_id %>

<aside class="hidden shrink-0 flex-col border-r border-border bg-bg-surface lg:flex lg:w-[244px] xl:w-[256px]">
  <div class="border-b border-border px-4 py-3.5">
    <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-content-muted">Kampagnen</div>
  </div>

  <div class="flex-1 space-y-2 overflow-y-auto px-2 py-3">
    <% campaigns.each do |campaign| %>
      <% campaign_active = active_campaign_id == campaign.id %>
      <details class="group/campaign rounded-xl <%= campaign_active ? 'bg-accent/10' : '' %>" <%= "open" if campaign_active %>>
        <summary class="flex cursor-pointer list-none items-center gap-2 rounded-xl px-2.5 py-2 text-content-secondary transition-colors hover:bg-bg-hover focus:outline-none focus:ring-2 focus:ring-accent">
          <svg class="h-3.5 w-3.5 text-content-muted transition-transform group-open/campaign:rotate-90" viewBox="0 0 16 16" fill="none">
            <path d="M6 4L10 8L6 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="min-w-0 flex-1 truncate text-[13px] font-bold <%= campaign_active ? 'text-accent' : 'text-content' %>"><%= campaign.name %></span>
          <% if internal_workspace_member? %>
            <div class="relative" data-controller="dropdown" data-dropdown-portal-value="true" data-dropdown-side-value="right">
              <button type="button"
                      data-dropdown-target="button"
                      data-action="click->dropdown#toggle"
                      aria-expanded="false"
                      class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg text-content-muted hover:bg-bg-hover hover:text-content focus:outline-none focus:ring-2 focus:ring-accent"
                      aria-label="Kampagnenaktionen">
                <span class="text-lg leading-none">...</span>
              </button>
              <div data-dropdown-target="menu" class="hidden z-[220] w-56 rounded-xl border border-border bg-bg-card p-2 shadow-lg">
                <%= form_with model: campaign, url: campaign_path(campaign), method: :patch, class: "space-y-2" do |form| %>
                  <%= form.text_field :name, required: true, aria: { label: "Kampagne umbenennen" }, class: "w-full rounded-lg border border-border bg-bg-card px-2 py-1.5 text-xs text-content focus:outline-none focus:ring-2 focus:ring-accent" %>
                  <%= form.submit "Umbenennen", class: "w-full rounded-lg bg-accent px-2 py-1.5 text-xs font-semibold text-content-inverse hover:bg-accent-hover cursor-pointer" %>
                <% end %>
                <div class="my-2 h-px bg-border"></div>
                <%= button_to "Duplizieren", duplicate_campaign_path(campaign), method: :post, class: "w-full rounded-lg px-2 py-1.5 text-left text-xs font-semibold text-content-secondary hover:bg-bg-hover cursor-pointer" %>
                <%= button_to "Archivieren", archive_campaign_path(campaign), method: :patch, data: { turbo_confirm: "Kampagne archivieren? Die enthaltenen Boards bleiben erhalten." }, class: "w-full rounded-lg px-2 py-1.5 text-left text-xs font-semibold text-status-error hover:bg-red-50 cursor-pointer" %>
              </div>
            </div>
          <% end %>
        </summary>

        <div class="space-y-1 pb-2 pl-5 pr-2">
          <% campaign.boards.active.ordered.each do |board| %>
            <% active = @board&.id == board.id %>
            <div class="flex items-center gap-1">
              <%= link_to board_path(board), class: "min-w-0 flex flex-1 items-center gap-2 rounded-lg px-2.5 py-2 transition-colors #{active ? 'bg-bg-surface text-accent shadow-[0_1px_2px_rgba(15,23,42,0.08)]' : 'text-content-secondary hover:bg-bg-hover'}", data: { turbo_frame: "_top" } do %>
                <span class="text-sm leading-none"><%= board.icon %></span>
                <span class="truncate text-[13px] font-semibold"><%= board.name %></span>
              <% end %>
              <% if internal_workspace_member? %>
                <div class="relative" data-controller="dropdown" data-dropdown-portal-value="true" data-dropdown-side-value="right">
                  <button type="button"
                          data-dropdown-target="button"
                          data-action="click->dropdown#toggle"
                          aria-expanded="false"
                          class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg text-content-muted hover:bg-bg-hover hover:text-content focus:outline-none focus:ring-2 focus:ring-accent"
                          aria-label="Boardaktionen">
                    <span class="text-lg leading-none">...</span>
                  </button>
                  <div data-dropdown-target="menu" class="hidden z-[220] w-56 rounded-xl border border-border bg-bg-card p-2 shadow-lg">
                    <%= form_with model: board, url: board_path(board), method: :patch, class: "space-y-2" do |form| %>
                      <%= form.text_field :name, required: true, aria: { label: "Board umbenennen" }, class: "w-full rounded-lg border border-border bg-bg-card px-2 py-1.5 text-xs text-content focus:outline-none focus:ring-2 focus:ring-accent" %>
                      <%= form.submit "Umbenennen", class: "w-full rounded-lg bg-accent px-2 py-1.5 text-xs font-semibold text-content-inverse hover:bg-accent-hover cursor-pointer" %>
                    <% end %>
                    <div class="my-2 h-px bg-border"></div>
                    <%= button_to "Duplizieren", duplicate_board_path(board), method: :post, class: "w-full rounded-lg px-2 py-1.5 text-left text-xs font-semibold text-content-secondary hover:bg-bg-hover cursor-pointer" %>
                    <%= button_to "Archivieren", archive_board_path(board), method: :patch, data: { turbo_confirm: "Board archivieren? Karten bleiben erhalten." }, class: "w-full rounded-lg px-2 py-1.5 text-left text-xs font-semibold text-status-error hover:bg-red-50 cursor-pointer" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if internal_workspace_member? %>
            <div class="rounded-lg" data-controller="dropdown">
              <button type="button"
                      data-dropdown-target="button"
                      data-action="click->dropdown#toggle"
                      aria-expanded="false"
                      class="flex w-full cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2 text-left text-[13px] font-semibold text-content-muted transition-colors hover:bg-bg-hover hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none"><path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                Board hinzufügen
              </button>
              <div data-dropdown-target="menu" class="hidden mt-2">
                <%= form_with model: Board.new, url: boards_path, class: "space-y-2 px-2" do |form| %>
                <%= form.hidden_field :campaign_id, value: campaign.id %>
                <%= form.text_field :name, required: true, placeholder: "Boardname", class: "w-full rounded-lg border border-border bg-bg-card px-2 py-1.5 text-xs text-content placeholder-content-muted focus:outline-none focus:ring-2 focus:ring-accent" %>
                <%= form.hidden_field :icon, value: "📋" %>
                <%= form.select :column_template, [["Standard Review", "standard_review"], ["Einfach", "simple"]], {}, class: "w-full rounded-lg border border-border bg-bg-card px-2 py-1.5 text-xs text-content focus:outline-none focus:ring-2 focus:ring-accent" %>
                <%= form.submit "Erstellen", class: "w-full rounded-lg bg-accent px-2 py-1.5 text-xs font-semibold text-content-inverse hover:bg-accent-hover cursor-pointer" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <% if internal_workspace_member? %>
    <div class="space-y-1.5 border-t border-border px-3 py-3">
      <button type="button"
              data-action="click->modal-manager#open"
              data-modal-manager-id-param="new-campaign-modal"
              class="flex w-full items-center justify-center gap-2 rounded-xl border border-border bg-bg-elevated px-3 py-2.5 text-[13px] font-semibold text-content-secondary transition-colors hover:bg-bg-hover cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        Neue Kampagne
      </button>
      <%= link_to "Archivierte Kampagnen", archived_campaigns_path, class: "block rounded-lg px-2 py-1.5 text-center text-xs font-semibold text-content-muted hover:bg-bg-hover hover:text-content" %>
    </div>
  <% end %>
</aside>
