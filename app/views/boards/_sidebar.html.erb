<aside class="hidden lg:flex lg:w-[220px] xl:w-[240px] shrink-0 flex-col border-r border-border bg-bg-surface">
  <div class="px-4 py-4 border-b border-border">
    <div class="text-[11px] font-semibold uppercase tracking-[0.08em] text-content-muted">Boards</div>
  </div>

  <div class="flex-1 overflow-y-auto px-2 py-3 space-y-1.5">
    <% @boards.each do |board| %>
      <% active = @board&.id == board.id %>
      <%= link_to board_path(board),
          class: "flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors #{active ? 'bg-accent/10' : 'hover:bg-bg-hover'}",
          data: { turbo_frame: "_top" } do %>
        <span class="text-base leading-none"><%= board.icon %></span>
        <span class="text-[13px] font-semibold truncate #{active ? 'text-accent' : 'text-content-secondary'}"><%= board.name %></span>
      <% end %>
    <% end %>
  </div>

  <div class="px-3 py-3 border-t border-border">
    <button type="button"
            onclick="document.getElementById('new-board-modal').classList.remove('hidden')"
            class="w-full flex items-center justify-center gap-2 rounded-xl bg-bg-elevated hover:bg-bg-hover text-content-secondary text-[13px] font-semibold px-3 py-2.5 transition-colors cursor-pointer border border-border">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 3V13M3 8H13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      New board
    </button>
  </div>
</aside>
