<% content_for :title, "#{@board.name} - #{app_name}" %>
<% @board_page = true %>

<%# Subscribe to real-time updates for this board %>
<%= turbo_stream_from "board_#{@board.id}" %>

<div class="h-full flex flex-col" data-controller="board">
  <%# Unified Navbar %>
  <%= render "shared/navbar" %>

  <%# Board modals (new board, settings) %>
  <%= render "boards/header" %>

  <%# Tag filter indicator %>
  <% if @current_tag.present? %>
    <div class="flex items-center gap-2 px-6 py-2 bg-bg-surface border-b border-border">
      <span class="text-xs text-content-muted">Filtered by:</span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-bg-elevated text-content">
        <%= @current_tag %>
        <%= link_to board_path(@board), class: "ml-1 hover:text-status-error" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3">
            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
          </svg>
        <% end %>
      </span>
    </div>
  <% end %>

  <%# Mobile status navigation %>
  <div class="md:hidden px-4 pt-3 pb-2 bg-bg-base border-b border-border/60">
    <div class="flex gap-2 overflow-x-auto no-scrollbar">
      <% Task.statuses.keys.each do |status| %>
        <button type="button"
                data-action="click->board#scrollToColumn"
                data-board-status-param="<%= status %>"
                data-board-target="columnTab"
                class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition-colors border border-white/8 bg-white/5 text-[#888]"
                style="scroll-snap-align:start">
          <span class="rounded-full" style="width:6px;height:6px;background:<%= Task::STATUS_COLORS[status] %>"></span>
          <span><%= Task::STATUS_LABELS[status] %></span>
          <span class="text-[10px] text-[#666]"><%= @columns[status.to_sym].count %></span>
        </button>
      <% end %>
    </div>
  </div>

  <%# Kanban Columns - scrollable page, variable height columns %>
  <div class="flex-1 bg-bg-base overflow-y-auto overflow-x-hidden md:overflow-auto">
    <div data-board-target="columnsViewport"
         data-action="scroll->board#handleColumnsScroll"
         class="h-full overflow-x-auto overflow-y-visible snap-x snap-mandatory md:overflow-visible">
      <div class="flex gap-3 items-start min-h-full md:min-w-0" style="padding:12px 16px 16px">
      <% Task.statuses.keys.each do |status| %>
        <%= render "boards/column", status: status, tasks: @columns[status.to_sym] %>
      <% end %>
      </div>
    </div>
  </div>

  <%# Task Panel Container - loaded via Turbo Frame %>
  <%= turbo_frame_tag "task_panel" %>


  <%# New Task Modal %>
  <%= turbo_frame_tag "new_task_modal" %>

</div>
