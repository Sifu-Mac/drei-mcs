<% content_for :title, "#{@board.name} - #{app_name}" %>
<% @board_page = true %>
<%= turbo_stream_from "board_#{@board.id}" %>

<div class="h-full flex flex-col" data-controller="board">
  <%= render "shared/navbar" %>
  <%= render "boards/header" %>

  <% if @current_tag.present? %>
    <div class="flex items-center gap-2 px-6 py-2 bg-bg-surface border-b border-border">
      <span class="text-xs text-content-muted">Gefiltert nach:</span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-bg-elevated text-content">
        <%= @current_tag %>
        <%= link_to board_path(@board), class: "ml-1 hover:text-status-error" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3 h-3">
            <path d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z" />
          </svg>
        <% end %>
      </span>
    </div>
  <% end %>

  <div class="flex-1 min-h-0 flex overflow-hidden bg-bg-base">
    <%= render "boards/sidebar" %>

    <div class="flex-1 min-w-0 flex flex-col overflow-hidden">
      <div class="md:hidden px-4 pt-3 pb-2 bg-bg-surface border-b border-border">
        <div class="flex gap-2 overflow-x-auto no-scrollbar">
          <% @board_columns.each do |column| %>
            <button type="button"
                    data-action="click->board#scrollToColumn"
                    data-board-column-id-param="<%= column.id %>"
                    data-board-target="columnTab"
                    class="shrink-0 inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-xs font-semibold transition-colors border border-border bg-bg-elevated text-content-muted"
                    style="scroll-snap-align:start">
              <span class="rounded-full" style="width:6px;height:6px;background:<%= Task::STATUS_COLORS[Task.legacy_status_for_kind(column.kind)] %>"></span>
              <span><%= column.name %></span>
              <span class="text-[10px] text-content-muted"><%= @columns[column].count %></span>
            </button>
          <% end %>
        </div>
      </div>

      <div class="flex-1 min-h-0 bg-bg-base overflow-hidden">
        <div data-board-target="columnsViewport"
             data-action="scroll->board#handleColumnsScroll"
             class="h-full overflow-x-auto overflow-y-hidden snap-x snap-mandatory overscroll-contain">
          <div class="flex h-full items-stretch gap-4 md:min-w-max" style="padding:18px 20px 22px">
            <% @board_columns.each do |column| %>
              <%= render "boards/column", column: column, tasks: @columns[column] %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= turbo_frame_tag "task_panel" %>
  <%= turbo_frame_tag "new_task_modal" %>
</div>
