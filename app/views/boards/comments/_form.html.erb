<div id="task-comment-form-<%= task.id %>">
  <%= form_with model: task.comments.new,
      url: board_task_comments_path(board, task),
      data: { controller: "comment-form", action: "comment:quote@window->comment-form#selectQuote" },
      html: { multipart: true } do |form| %>
    <div style="display:flex;flex-direction:column;gap:10px">
      <%= form.hidden_field :quoted_comment_id, data: { comment_form_target: "quoteId" } %>
      <div hidden data-comment-form-target="quotePreview" style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px;padding:9px 10px;border-left:3px solid #8b5cf6;border-radius:8px;background:#f5f3ff;color:#4c1d95;font-size:12px">
        <div style="min-width:0">
          <strong data-comment-form-target="quoteAuthor"></strong>
          <div data-comment-form-target="quoteBody" style="margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"></div>
        </div>
        <button type="button" aria-label="Zitat entfernen" data-action="comment-form#clearQuote" style="border:0;background:transparent;color:#6d28d9;font-size:16px;line-height:1;cursor:pointer">×</button>
      </div>
      <%= form.text_area :body,
          rows: 3,
          placeholder: "Write a comment...",
          style: "width:100%;min-height:64px;max-height:180px;padding:14px 15px;border-radius:12px;border:1px solid #e5e7eb;background:#ffffff;font-size:15px;color:#1f2937;resize:none;outline:none;line-height:1.65;font-family:inherit",
          data: { comment_form_target: "input", action: "input->comment-form#autoResize keydown->comment-form#submitOnEnter" } %>
      <% if local_assigns[:comment].present? && comment.errors.any? %>
        <div style="font-size:11px;font-weight:500;color:#ef4444"><%= comment.errors.full_messages.join(", ") %></div>
      <% end %>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
        <%= form.file_field :images,
            multiple: true,
            accept: "image/jpeg,image/png,image/webp,image/gif",
            style: "max-width:280px;font-size:12px;color:#6b7280" %>
        <%= form.submit "Post comment", style: "padding:10px 15px;border-radius:10px;background:#1e5eff;border:none;color:#ffffff;font-size:13px;font-weight:800;cursor:pointer" %>
      </div>
    </div>
  <% end %>
</div>
