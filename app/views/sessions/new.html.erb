<% content_for :title, "Sign in" %>
<div class="max-w-md mx-auto min-h-full flex flex-col justify-center py-8 md:py-12">
  <div class="text-left max-w-sm mb-6">
    <h1 class="text-2xl tracking-tight mb-4 text-content font-display">Welcome back!</h1>
    <p class="text-md text-content-secondary -mt-2 mb-4">Sign in to continue to DREI Asset Review.</p>
  </div>

  <%= form_with url: session_url, class: "space-y-2 font-normal mb-6", html: { autocomplete: "off" } do |form| %>
    <div class="isolate -space-y-px rounded-md">
      <div class="auth-field relative bg-bg-elevated rounded-t-md px-3 pb-1.5 pt-2.5 ring-1 ring-inset ring-border focus-within:z-10 focus-within:ring-2 focus-within:ring-border-accent">
        <%= form.label :email_address, "Email", class: "block text-xs font-medium text-content-muted" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "email", placeholder: "name@domain.com", value: params[:email_address], class: "auth-field-input block w-full border-0 p-0 text-content placeholder:text-content-muted focus:ring-0 text-sm leading-6 bg-transparent" %>
      </div>
      <div class="auth-field relative bg-bg-elevated rounded-b-md px-3 pb-1.5 pt-2.5 ring-1 ring-inset ring-border focus-within:z-10 focus-within:ring-2 focus-within:ring-border-accent">
        <%= form.label :password, "Password", class: "block text-xs font-medium text-content-muted" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Enter password", class: "auth-field-input block w-full border-0 p-0 text-content placeholder:text-content-muted focus:ring-0 text-sm leading-6 bg-transparent" %>
      </div>
    </div>
    <div class="pt-3 font-medium flex items-center justify-between">
      <%= form.submit "Sign in", class: "cursor-pointer inline-flex items-center space-x-2 rounded-md bg-accent p-3 text-xs font-semibold text-content-inverse transition-colors duration-150 hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 active:scale-[0.98]" %>
      <div class="flex items-center gap-3">
        <%= link_to "Forgot password?", new_password_path, class: "text-xs text-content-secondary hover:text-content transition-colors" %>
      </div>
    </div>
  <% end %>

  <p class="text-xs text-content-muted">Account creation is restricted. Ask an admin to create your user.</p>
</div>
