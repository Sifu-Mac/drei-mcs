<% if internal_workspace_member? %>
<div id="new-campaign-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
  <div class="absolute inset-0 bg-slate-900/25 backdrop-blur-sm" onclick="document.getElementById('new-campaign-modal').classList.add('hidden')"></div>
  <div class="relative bg-bg-surface border border-border rounded-xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden" style="box-shadow:0 24px 70px rgba(15,23,42,0.18);">
    <div class="px-5 py-4 border-b border-border flex items-center justify-between">
      <span class="text-sm font-bold text-content">Neue Kampagne</span>
      <button type="button"
              onclick="document.getElementById('new-campaign-modal').classList.add('hidden')"
              class="p-2 rounded-lg text-content-muted hover:text-content hover:bg-bg-hover transition-colors cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <%= form_with model: Campaign.new, url: campaigns_path, class: "p-5 space-y-4" do |form| %>
      <div>
        <label class="block text-sm font-medium text-content-secondary mb-2">Kampagnenname</label>
        <%= form.text_field :name,
            required: true,
            placeholder: "z. B. Herbstkampagne",
            class: "w-full px-3 py-2 text-sm bg-bg-card border border-border rounded-lg focus:outline-none focus:ring-2 focus:ring-accent text-content placeholder-content-muted" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button"
                onclick="document.getElementById('new-campaign-modal').classList.add('hidden')"
                class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-bg-elevated hover:bg-bg-hover text-content-secondary border border-border transition-colors cursor-pointer">
          Abbrechen
        </button>
        <%= form.submit "Kampagne erstellen", class: "px-3 py-1.5 text-xs font-semibold rounded-lg bg-accent text-content-inverse hover:bg-accent-hover transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<% end %>
