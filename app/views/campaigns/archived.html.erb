<div class="min-h-screen bg-bg px-6 py-8">
  <div class="mx-auto max-w-4xl">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold text-content">Archivierte Kampagnen</h1>
        <p class="mt-1 text-sm text-content-muted">Archivierte Kampagnen bleiben erhalten und können wiederhergestellt werden.</p>
      </div>
      <%= link_to "Zurück zu den Boards", boards_path, class: "rounded-lg border border-border bg-bg-card px-3 py-2 text-sm font-semibold text-content-secondary hover:bg-bg-hover" %>
    </div>

    <% if @campaigns.any? %>
      <div class="space-y-3">
        <% @campaigns.each do |campaign| %>
          <div class="rounded-xl border border-border bg-bg-card p-4 shadow-sm">
            <div class="flex items-center justify-between gap-4">
              <div>
                <div class="font-semibold text-content"><%= campaign.name %></div>
                <div class="text-sm text-content-muted"><%= pluralize(campaign.boards.unscoped.where(campaign_id: campaign.id).count, "Board", "Boards") %></div>
              </div>
              <div class="flex items-center gap-2">
                <%= button_to "Wiederherstellen", restore_campaign_path(campaign), method: :patch, class: "rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-content-inverse hover:bg-accent-hover cursor-pointer" %>
                <% if current_user.admin? %>
                  <details class="relative">
                    <summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-status-error hover:bg-red-50">Endgültig löschen</summary>
                    <div class="absolute right-0 z-10 mt-2 w-80 rounded-xl border border-red-200 bg-bg-card p-4 shadow-lg">
                      <p class="text-sm font-semibold text-content">Diese Kampagne wird unwiderruflich gelöscht.</p>
                      <p class="mt-1 text-xs text-content-muted">Gib <strong><%= campaign.name %></strong> zur Bestätigung ein.</p>
                      <%= form_with url: destroy_permanently_campaign_path(campaign), method: :delete, class: "mt-3 space-y-2" do |form| %>
                        <%= form.text_field :confirmation, required: true, autocomplete: "off", aria: { label: "Kampagnenname zur Löschbestätigung" }, class: "block w-full rounded-md border border-border bg-bg-elevated px-3 py-2 text-sm text-content focus:outline-none focus:ring-1 focus:ring-status-error" %>
                        <%= form.submit "Endgültig löschen", data: { turbo_confirm: "Diese Aktion kann nicht rückgängig gemacht werden. Fortfahren?" }, class: "cursor-pointer rounded-lg bg-red-600 px-3 py-2 text-xs font-semibold text-white hover:bg-red-700" %>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-border bg-bg-card p-8 text-center text-sm text-content-muted">
        Keine archivierten Kampagnen vorhanden.
      </div>
    <% end %>
  </div>
</div>
