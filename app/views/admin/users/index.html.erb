<% content_for :title, "Benutzerrechte - Admin - #{app_name}" %>
<% content_for :nav_center, "Benutzerrechte" %>

<% users_content = capture do %>
<section id="admin-users" class="space-y-6">
  <!-- Zurück-Link -->
  <div class="flex items-center gap-3">
    <%= link_to admin_root_path, class: "text-stone-600 dark:text-purple-100 hover:text-stone-900 dark:hover:text-stone-100 transition-colors" do %>
      ← Zurück zur Admin-Übersicht
    <% end %>
  </div>

  <div class="bg-stone-100 dark:bg-white/10 rounded-md p-5">
    <h2 class="text-sm font-semibold text-stone-900 dark:text-stone-100">Rollen</h2>
    <p class="mt-2 text-sm text-stone-600 dark:text-purple-100">Es gibt nur zwei Rollen: Admin verwaltet das System, Clients arbeiten an den gemeinsamen Boards. Neue Personen werden über <%= link_to "User hinzufügen", admin_invites_path, class: "font-semibold underline" %> eingeladen.</p>
  </div>

  <!-- Benutzertabelle -->
  <div class="bg-stone-100 dark:bg-white/10 rounded-md overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-stone-200 dark:bg-white/20">
          <tr>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">E-Mail</th>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Erstellt</th>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Letzte Anmeldung</th>
            <th class="px-5 py-3 text-center text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Rolle</th>
            <th class="px-5 py-3 text-right text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Aktionen</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-200 dark:divide-white/10">
          <% @users.each do |user_data| %>
            <tr class="hover:bg-stone-200 dark:hover:bg-white/20 transition-colors">
              <td class="px-5 py-4 text-sm text-stone-900 dark:text-stone-100">
                <div class="flex items-center justify-between gap-3">
                  <span><%= user_data[:email] %></span>
                  <% unless user_data[:user] == current_user %>
                    <%= button_to "Löschen",
                        admin_user_path(user_data[:user]),
                        method: :delete,
                        data: { turbo_confirm: "Benutzer wirklich löschen?" },
                        class: "px-2.5 py-1 text-xs font-semibold rounded bg-red-500/12 text-red-400 border border-red-500/20 hover:bg-red-500/18 transition-colors cursor-pointer" %>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-4 text-sm text-stone-600 dark:text-purple-100">
                <%= user_data[:created_at].strftime("%b %d, %Y") %>
              </td>
              <td class="px-5 py-4 text-sm text-stone-600 dark:text-purple-100">
                <% if user_data[:last_login] %>
                  <%= time_ago_in_words(user_data[:last_login]) %> ago
                <% else %>
                  <span class="text-stone-400 dark:text-white/40">Nie</span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-sm text-center text-stone-900 dark:text-stone-100 font-semibold">
                <%= user_data[:user].admin? ? "Admin" : "Client" %>
              </td>
              <td class="px-5 py-4 text-right text-sm">
                <% if user_data[:user].admin? && user_data[:user] != current_user %>
                  <%= button_to "Zu Client machen", demote_admin_user_path(user_data[:user]), method: :patch, data: { turbo_confirm: "Adminrechte für #{user_data[:email]} wirklich entziehen?" }, class: "mr-2 rounded px-2.5 py-1 text-xs font-semibold text-status-error hover:bg-red-50" %>
                <% elsif !user_data[:user].admin? %>
                  <%= button_to "Zum Admin machen", promote_admin_user_path(user_data[:user]), method: :patch, data: { turbo_confirm: "#{user_data[:email]} wirklich zum Admin machen?" }, class: "mr-2 rounded px-2.5 py-1 text-xs font-semibold text-accent hover:bg-bg-hover" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Zusammenfassung -->
  <div class="text-sm text-stone-600 dark:text-purple-100 text-center">
    Insgesamt: <%= @users.count %> Benutzer
  </div>
</section>
<% end %>

<% if turbo_frame_request? %>
  <%= render "admin/shared/overlay", title: "Benutzerverwaltung" do %>
    <%= users_content %>
  <% end %>
<% else %>
  <%= users_content %>
<% end %>
