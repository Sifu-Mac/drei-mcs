<% content_for :title, "Benutzer - Admin - #{app_name}" %>
<% content_for :nav_center, "Benutzerverwaltung" %>

<% users_content = capture do %>
<section id="admin-users" class="space-y-6">
  <!-- Zurück-Link -->
  <div class="flex items-center gap-3">
    <%= link_to admin_root_path, class: "text-stone-600 dark:text-purple-100 hover:text-stone-900 dark:hover:text-stone-100 transition-colors" do %>
      ← Zurück zur Admin-Übersicht
    <% end %>
  </div>

  <div class="bg-stone-100 dark:bg-white/10 rounded-md p-5 space-y-4">
    <h2 class="text-sm font-semibold text-stone-900 dark:text-stone-100">Benutzer erstellen</h2>

    <%= form_with model: @new_user, url: admin_users_path, class: "space-y-4" do |form| %>
      <% if @new_user.errors.any? %>
        <div class="p-3 rounded-md bg-red-500/10 text-red-400 text-xs">
          <%= @new_user.errors.full_messages.join(", ") %>
        </div>
      <% end %>

      <div class="grid gap-4 md:grid-cols-3">
        <div>
          <label class="block text-xs font-semibold text-stone-700 dark:text-purple-100 mb-1.5">E-Mail</label>
          <%= form.email_field :email_address, required: true, class: "w-full rounded-md px-3 py-2 text-sm bg-white dark:bg-white/5 border border-stone-300 dark:border-white/10 text-stone-900 dark:text-stone-100" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-700 dark:text-purple-100 mb-1.5">Passwort</label>
          <%= form.password_field :password, required: true, class: "w-full rounded-md px-3 py-2 text-sm bg-white dark:bg-white/5 border border-stone-300 dark:border-white/10 text-stone-900 dark:text-stone-100" %>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-700 dark:text-purple-100 mb-1.5">Passwort bestätigen</label>
          <%= form.password_field :password_confirmation, required: true, class: "w-full rounded-md px-3 py-2 text-sm bg-white dark:bg-white/5 border border-stone-300 dark:border-white/10 text-stone-900 dark:text-stone-100" %>
        </div>
      </div>

      <label class="inline-flex items-center gap-2 text-sm text-stone-700 dark:text-purple-100">
        <%= form.check_box :admin %>
        Als Admin erstellen
      </label>

      <div>
        <%= form.submit "Benutzer erstellen", class: "px-4 py-2 rounded-md text-xs font-semibold bg-stone-900 text-white dark:bg-white dark:text-stone-900 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Benutzertabelle -->
  <div class="bg-stone-100 dark:bg-white/10 rounded-md overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-stone-200 dark:bg-white/20">
          <tr>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">E-Mail</th>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Erstellt</th>
            <th class="px-5 py-3 text-left text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Letzte Anmeldung</th>
            <th class="px-5 py-3 text-center text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Rolle</th>
            <th class="px-5 py-3 text-center text-xs font-semibold tracking-tight text-stone-900 dark:text-stone-100">Karten</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-200 dark:divide-white/10">
          <% @users.each do |user_data| %>
            <tr class="hover:bg-stone-200 dark:hover:bg-white/20 transition-colors">
              <td class="px-5 py-4 text-sm text-stone-900 dark:text-stone-100">
                <div class="flex items-center justify-between gap-3">
                  <span><%= user_data[:email] %></span>
                  <% unless user_data[:user] == current_user %>
                    <%= button_to "Löschen",
                        admin_user_path(user_data[:user]),
                        method: :delete,
                        data: { turbo_confirm: "Benutzer wirklich löschen?" },
                        class: "px-2.5 py-1 text-xs font-semibold rounded bg-red-500/12 text-red-400 border border-red-500/20 hover:bg-red-500/18 transition-colors cursor-pointer" %>
                  <% end %>
                </div>
              </td>
              <td class="px-5 py-4 text-sm text-stone-600 dark:text-purple-100">
                <%= user_data[:created_at].strftime("%b %d, %Y") %>
              </td>
              <td class="px-5 py-4 text-sm text-stone-600 dark:text-purple-100">
                <% if user_data[:last_login] %>
                  <%= time_ago_in_words(user_data[:last_login]) %> ago
                <% else %>
                  <span class="text-stone-400 dark:text-white/40">Nie</span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-sm text-center text-stone-900 dark:text-stone-100 font-semibold">
                <%= user_data[:user].admin? ? "Admin" : "Benutzer" %>
              </td>
              <td class="px-5 py-4 text-sm text-center text-stone-900 dark:text-stone-100 font-semibold">
                <%= user_data[:tasks_count] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Zusammenfassung -->
  <div class="text-sm text-stone-600 dark:text-purple-100 text-center">
    Insgesamt: <%= @users.count %> Benutzer
  </div>
</section>
<% end %>

<% if turbo_frame_request? %>
  <%= render "admin/shared/overlay", title: "Benutzerverwaltung" do %>
    <%= users_content %>
  <% end %>
<% else %>
  <%= users_content %>
<% end %>
