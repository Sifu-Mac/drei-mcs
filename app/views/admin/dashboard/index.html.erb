<% content_for :title, "Admin-Übersicht - #{app_name}" %>
<% content_for :nav_center, "Admin-Übersicht" %>

<% dashboard_content = capture do %>
<section id="admin-dashboard" class="max-w-lg mx-auto space-y-6">
  <!-- Begrüßung -->
  <div class="bg-bg-surface border border-border p-5 rounded-lg shadow-sm">
    <h1 class="text-xl font-semibold text-content mb-2">
      Willkommen, <%= current_user.email_address %>
    </h1>
    <p class="text-sm text-content-secondary">
      Administration für <%= app_name %>
    </p>
  </div>

  <!-- Kennzahlen -->
  <div class="grid grid-cols-2 gap-4">
    <!-- Benutzer insgesamt -->
    <%= link_to admin_users_path, class: "block bg-bg-surface border border-border p-5 rounded-lg hover:bg-bg-hover transition-colors shadow-sm" do %>
      <div class="text-3xl font-bold text-content mb-2">
        <%= @total_users %>
      </div>
      <div class="text-sm text-content-secondary">
        Benutzer insgesamt
      </div>
    <% end %>

    <!-- Karten insgesamt -->
    <div class="bg-bg-surface border border-border p-5 rounded-lg hover:bg-bg-hover transition-colors shadow-sm">
      <div class="text-3xl font-bold text-content mb-2">
        <%= @total_tasks %>
      </div>
      <div class="text-sm text-content-secondary">
        Karten insgesamt
      </div>
    </div>

    <!-- Neue Benutzer -->
    <div class="bg-bg-surface border border-border p-5 rounded-lg hover:bg-bg-hover transition-colors col-span-2 shadow-sm">
      <div class="text-3xl font-bold text-content mb-2">
        <%= @recent_signups %>
      </div>
      <div class="text-sm text-content-secondary">
        Neue Benutzer (7 Tage)
      </div>
    </div>

    <!-- Offene Einladungen -->
    <%= link_to admin_invites_path, class: "block bg-bg-surface border border-border p-5 rounded-lg hover:bg-bg-hover transition-colors col-span-2 shadow-sm" do %>
      <div class="text-3xl font-bold text-content mb-2">
        <%= @pending_invites %>
      </div>
      <div class="text-sm text-content-secondary">
        Offene Einladungen
      </div>
    <% end %>
  </div>
</section>
<% end %>

<% if turbo_frame_request? %>
  <%= render "admin/shared/overlay", title: "Admin-Übersicht" do %>
    <%= dashboard_content %>
  <% end %>
<% else %>
  <%= dashboard_content %>
<% end %>
