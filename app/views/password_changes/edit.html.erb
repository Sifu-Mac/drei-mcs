<% content_for :title, "Passwort ändern" %>
<% content_for :breadcrumb_standalone, "Passwort ändern" %>

<div class="mt-12 max-w-xl space-y-6">
  <div class="rounded-lg border border-border bg-bg-surface p-5">
    <h1 class="text-sm font-semibold text-content">Sicherheit</h1>
    <p class="mt-1 text-xs text-content-muted">Nach dem Speichern werden andere aktive Sitzungen abgemeldet.</p>

    <% if flash.now[:alert].present? %>
      <p class="mt-4 rounded-md bg-red-50 px-3 py-2 text-sm text-status-error"><%= flash.now[:alert] %></p>
    <% end %>

    <%= form_with url: password_change_path, method: :patch, scope: :user, class: "mt-5 space-y-4" do |form| %>
      <div>
        <%= form.label :current_password, "Aktuelles Passwort", class: "mb-1.5 block text-xs font-medium text-content-secondary" %>
        <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "block w-full rounded-md bg-bg-elevated px-3 py-2 text-sm text-content focus:outline-none focus:ring-1 focus:ring-accent" %>
      </div>
      <div>
        <%= form.label :password, "Neues Passwort", class: "mb-1.5 block text-xs font-medium text-content-secondary" %>
        <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "block w-full rounded-md bg-bg-elevated px-3 py-2 text-sm text-content focus:outline-none focus:ring-1 focus:ring-accent" %>
      </div>
      <div>
        <%= form.label :password_confirmation, "Neues Passwort bestätigen", class: "mb-1.5 block text-xs font-medium text-content-secondary" %>
        <%= form.password_field :password_confirmation, required: true, minlength: 8, autocomplete: "new-password", class: "block w-full rounded-md bg-bg-elevated px-3 py-2 text-sm text-content focus:outline-none focus:ring-1 focus:ring-accent" %>
      </div>
      <% if current_user.errors.any? %>
        <p class="text-sm text-status-error"><%= current_user.errors.full_messages.to_sentence %></p>
      <% end %>
      <div class="flex items-center gap-3 pt-1">
        <%= form.submit "Passwort speichern", class: "cursor-pointer rounded-lg bg-accent px-4 py-2 text-xs font-semibold text-content-inverse hover:bg-accent-hover" %>
        <%= link_to "Abbrechen", settings_path, class: "text-xs font-semibold text-content-secondary hover:text-content" %>
      </div>
    <% end %>
  </div>
</div>
