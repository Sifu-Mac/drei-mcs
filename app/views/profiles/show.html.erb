<% content_for :title, "Einstellungen" %>
<% content_for :breadcrumb_standalone, "Einstellungen" %>

<div class="space-y-6 mt-12">
  <!-- Profil -->
  <div class="bg-bg-surface border border-border rounded-lg p-5 space-y-4">
    <h3 class="text-xs font-medium text-content-muted uppercase tracking-wider font-display">Profil</h3>

    <%= form_with(model: @user, url: settings_path, method: :patch, class: "space-y-4") do |form| %>
      <!-- Avatar -->
      <div>
        <label class="block text-xs font-medium text-content-secondary mb-2">Avatar</label>
        <div class="flex items-center gap-4">
          <% if @user.has_avatar? %>
            <%= image_tag @user.avatar_source, class: "w-14 h-14 object-cover rounded-full" %>
          <% else %>
            <div class="w-14 h-14 rounded-full bg-bg-elevated flex items-center justify-center">
              <svg class="w-7 h-7 text-content-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          <% end %>
          <div class="flex-1">
            <%= form.file_field :avatar, accept: "image/jpeg,image/jpg,image/png,image/webp", class: "block w-full text-xs text-content-secondary file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-medium file:bg-bg-elevated file:text-content-secondary hover:file:bg-bg-hover file:cursor-pointer file:transition-colors" %>
            <p class="text-xs text-content-muted mt-1">Maximal 512 KB und 256 × 256 Pixel. JPEG, PNG oder WebP.</p>
          </div>
        </div>
        <% if @user.avatar.attached? || @user.avatar_url.present? %>
          <div class="mt-3">
            <label class="flex items-center text-xs text-content-secondary cursor-pointer">
              <%= form.check_box :remove_avatar, class: "mr-2 rounded border-border bg-bg-elevated text-accent focus:ring-accent focus:ring-offset-bg-surface" %>
              Avatar entfernen
            </label>
          </div>
        <% end %>
        <% if @user.errors[:avatar].any? %>
          <div class="mt-2">
            <% @user.errors[:avatar].each do |error| %>
              <p class="text-status-error text-xs">Avatar <%= error %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- E-Mail -->
      <div class="pt-4 border-t border-border">
        <label class="block text-xs font-medium text-content-secondary mb-1.5">E-Mail-Adresse</label>
        <%= form.email_field :email_address, placeholder: "name@domain.de", class: "block w-full bg-bg-elevated border-0 rounded-md px-3 py-2 text-sm text-content placeholder:text-content-muted focus:ring-1 focus:ring-accent focus:outline-none" %>
        <% if @user.errors[:email_address].any? %>
          <div class="mt-1">
            <% @user.errors[:email_address].each do |error| %>
              <p class="text-status-error text-xs">Email <%= error %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="pt-2">
        <%= form.submit "Profil speichern", class: "cursor-pointer px-4 py-2 bg-accent text-content hover:bg-accent-hover text-xs font-semibold rounded-md transition-colors duration-200" %>
      </div>
    <% end %>
  </div>

  <!-- OpenClaw-Integration -->
  <div class="bg-bg-surface border border-border rounded-lg p-5 space-y-4">
    <div class="flex items-center gap-2">
      <span class="text-lg">🦞</span>
      <h3 class="text-sm font-semibold text-content font-display">OpenClaw-Integration</h3>
    </div>

    <p class="text-xs text-content-secondary">
      Verbinde deinen OpenClaw-Agent mit DREI Asset Review. Kopiere den Prompt und füge ihn in der Agent-Konfiguration ein.
    </p>

    <% api_url = "#{request.base_url}/api/v1" %>
    <% api_token = @api_token.token %>

    <div class="bg-bg-elevated rounded-md p-4 space-y-3 border border-border/50"
         data-controller="token-visibility"
         data-token-visibility-token-value="<%= api_token %>">
      <div>
        <p class="text-xs font-medium text-content-secondary mb-2">API Token</p>
        <div class="rounded-md bg-bg-surface px-3 py-2 border border-border">
          <code class="text-xs font-mono text-content-secondary break-all"
                data-token-visibility-target="value"
                aria-label="Maskierter API-Token"></code>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div data-controller="clipboard" data-clipboard-text-value="<%= api_token %>">
          <button
            type="button"
            data-action="click->clipboard#copy"
            class="cursor-pointer px-3 py-1.5 bg-bg-surface hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors border border-border"
          >
            <span data-clipboard-target="label">Token kopieren</span>
          </button>
        </div>
        <button type="button"
                data-action="click->token-visibility#toggle"
                data-token-visibility-target="button"
                aria-pressed="false"
                class="cursor-pointer px-3 py-1.5 bg-bg-surface hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors border border-border">
          Anzeigen
        </button>
        <%= button_to "Token neu erstellen", regenerate_api_token_settings_path,
            method: :post,
            data: { turbo_confirm: "Der aktuelle Token wird dadurch ungültig. Fortfahren?" },
            class: "cursor-pointer text-xs text-content-muted hover:text-content-secondary transition-colors" %>
      </div>
    </div>

    <!-- Ausführlicher Agent-Prompt -->
    <div data-controller="clipboard">
      <p class="text-xs font-medium text-content-secondary mb-2">Agent-Prompt</p>
      <div class="bg-bg-elevated rounded-md max-h-96 overflow-y-auto">
        <pre
          data-clipboard-target="source"
          class="px-3 py-3 text-xs font-mono text-content-secondary whitespace-pre-wrap break-words leading-relaxed">
# DREI Asset Review - Dein Arbeitsboard

DREI Asset Review ist der Ort, an dem Kampagnen, Karten und Prüfungen gesteuert werden. Betrachte es als gemeinsames Arbeitsboard.

## So funktioniert es

1. Dein Mensch erstellt Karten und organisiert sie auf dem Board.
2. Sobald eine Karte bereit ist, weist dein Mensch sie dir ausdrücklich zu.
3. Du fragst regelmäßig zugewiesene Karten ab und bearbeitest sie.
4. Du aktualisierst den Fortschritt und markierst abgeschlossene Arbeit.
5. Dein Mensch sieht alle Änderungen in Echtzeit.

## Verbindung

- **API-URL:** <%= api_url %>
- **Token:** <%= api_token %>
- **Authentifizierungs-Header:** `Authorization: Bearer <%= api_token %>`

## Identifikation

Sende diese Header bei jeder Anfrage, damit dein Mensch den verbundenen Agenten erkennt:
- `X-Agent-Name`: Dein Name (z. B. "<%= @user.agent_name.presence || "OpenClaw" %>")
- `X-Agent-Emoji`: Dein Emoji (z. B. "<%= @user.agent_emoji.presence || "🦞" %>")

## Arbeitsablauf

### Zugewiesene Karten abfragen (alle 30 Sekunden oder beim Heartbeat):
1. Rufe `GET /tasks?assigned=true` auf.
2. Waehle die erste und damit aelteste Zuweisung.
3. Verschiebe sie nach `in_progress` und beginne mit der Arbeit.

### Beim Bearbeiten:
- **Hilfe benoetigt:** Verschiebe die Karte nach `blocked`.
- **Fertig:** Verschiebe sie nach `review` oder `done`.

### Ausserdem kannst du:
- Neue Karten fuer Ideen und Folgearbeiten erstellen.
- Kartendetails und Aktivitaeten pruefen.

## API-Referenz

**Zugewiesene Karten abrufen:**
`GET /tasks?assigned=true`
Liefert zugewiesene Karten, aelteste Zuweisung zuerst.

**Alle Karten auflisten:**
`GET /tasks` oder `GET /tasks?status=in_progress`

**Karte abrufen:**
`GET /tasks/:id`

**Karte aktualisieren:**
`PATCH /tasks/:id`
Anfragekörper: `{ "status": "in_progress" }` oder `{ "status": "blocked" }`

**Karte abschliessen:**
`PATCH /tasks/:id/complete`

**Karte erstellen:**
`POST /tasks`
Anfragekörper: `{ "name": "Kartentitel", "status": "inbox" }`

## Statuswerte
- `inbox` — Neu und noch nicht priorisiert
- `planned` — Erfasst, aber noch nicht bereit
- `ready` — Priorisiert und bereit
- `in_progress` — In Bearbeitung
- `blocked` — Blockiert und wartet auf Hilfe
- `review` — Erledigt, benötigt menschliche Prüfung
- `done` — Abgeschlossen

## Prioritaeten
`none`, `low`, `medium`, `high`

## Tipps
- Frage Zuweisungen regelmaessig ab.
- Verschiebe blockierte Arbeit nach `blocked`.
- Erstelle Karten fuer spaetere Beobachtungen und Folgearbeiten.</pre>
      </div>
      <div class="flex items-center gap-3 mt-2">
        <button
          type="button"
          data-action="click->clipboard#copy"
          class="cursor-pointer px-3 py-1.5 bg-bg-elevated hover:bg-bg-hover text-content-secondary text-xs font-medium rounded-md transition-colors"
        >
          <span data-clipboard-target="label">Prompt kopieren</span>
        </button>
      </div>
    </div>

    <!-- Verbundener Agent -->
    <div class="pt-4 border-t border-border">
      <p class="text-xs font-medium text-content-secondary mb-3">Verbundener Agent</p>

      <% if @user.agent_last_active_at.present? %>
        <div class="flex items-center gap-3">
          <span class="text-xl"><%= @user.agent_emoji || "🦞" %></span>
          <span class="text-sm text-content"><%= @user.agent_name || "Agent" %></span>
          <span class="text-xs text-content-muted">•</span>
          <span class="text-xs text-content-muted">Zuletzt aktiv: vor <%= time_ago_in_words(@user.agent_last_active_at) %></span>
        </div>
      <% else %>
        <p class="text-xs text-content-muted">Noch kein Agent verbunden</p>
      <% end %>
    </div>
  </div>
</div>
