<% content_for :title, "Accept your invite" %>
<div class="max-w-md mx-auto min-h-full flex flex-col justify-center py-8 md:py-12">
  <% if @invite&.usable? %>
    <div class="text-left max-w-sm mb-6">
      <h1 class="text-2xl tracking-tight mb-4 text-content font-display">You're invited!</h1>
      <p class="text-md text-content-secondary -mt-2 mb-4">
        Set a password to activate your account for <%= @invite.email %>.
      </p>
    </div>

    <% if flash[:alert] %>
      <div class="p-3 rounded-md bg-red-500/10 text-red-400 text-xs mb-4">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: invite_path(@invite.token), method: :patch, class: "space-y-2 font-normal mb-6", html: { autocomplete: "off" } do |form| %>
      <div class="isolate -space-y-px rounded-md">
        <div class="relative bg-bg-elevated rounded-t-md px-3 pb-1.5 pt-2.5 ring-1 ring-inset ring-border focus-within:z-10 focus-within:ring-1 focus-within:ring-accent">
          <%= form.label :password, "Password", class: "block text-xs font-medium text-content-muted" %>
          <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "Choose a password", class: "block w-full border-0 p-0 text-content placeholder:text-content-muted focus:ring-0 text-sm leading-6 bg-transparent" %>
        </div>
        <div class="relative bg-bg-elevated rounded-b-md px-3 pb-1.5 pt-2.5 ring-1 ring-inset ring-border focus-within:z-10 focus-within:ring-1 focus-within:ring-accent">
          <%= form.label :password_confirmation, "Confirm password", class: "block text-xs font-medium text-content-muted" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Confirm your password", class: "block w-full border-0 p-0 text-content placeholder:text-content-muted focus:ring-0 text-sm leading-6 bg-transparent" %>
        </div>
      </div>
      <div class="pt-3 font-medium">
        <%= form.submit "Create account", class: "cursor-pointer inline-flex items-center space-x-2 p-3 bg-accent text-content rounded-md hover:bg-accent-hover transition-colors duration-200 text-xs font-semibold" %>
      </div>
    <% end %>
  <% else %>
    <div class="text-left max-w-sm mb-6">
      <h1 class="text-2xl tracking-tight mb-4 text-content font-display">Invite not available</h1>
      <p class="text-md text-content-secondary -mt-2 mb-4">
        This invite link is invalid, expired, or has already been used. Ask an admin to send you a new one.
      </p>
      <%= link_to "Go to sign in", new_session_path, class: "text-xs text-content-secondary hover:text-content transition-colors" %>
    </div>
  <% end %>
</div>
